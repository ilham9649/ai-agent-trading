# Copy to .env and fill in. .env is gitignored — never commit secrets.

# --- GLM brain (z.ai PAYG, OpenAI-compatible). Optional in paper mode. ---
# Get a key at https://z.ai/manage-apikey/apikey-list (use the GENERAL/PAYG key,
# NOT the Coding Plan key — that is IDE-gated and will error/throttle for a bot).
ZAI_API_KEY=

# --- Base L2 RPC (public is fine for paper; use Alchemy/QuickNode for live) ---
BASE_RPC_URL=https://mainnet.base.org

# --- Live execution only (leave blank in paper mode) ---
# AWS KMS key id for the dedicated hot-wallet signer (ECC_SECG_P256K1).
HOT_WALLET_KMS_KEY_ID=
# Hot wallet address (the EOA derived from the KMS public key). Fund only what the bot may lose.
HOT_WALLET_ADDRESS=

# --- Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Operational ---
TZ=Asia/Jakarta
LOG_LEVEL=INFO
